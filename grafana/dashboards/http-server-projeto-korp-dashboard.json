{
  "title": "HTTP Server Projeto Korp",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Disponibilidade",
      "targets": [{"expr": "http_server_projeto_korp_up"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
