    {
      "type": "timeseries",
      "title": "Volume de requisições por método e status",
      "targets": [{"expr": "sum by (method, status_code) (increase(http_server_projeto_korp_requests_total[1m]))"}],
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0}
    }
  ]
}
